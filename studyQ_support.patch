+def test_group_flash_file_end_to_end(tmp_path):
+    rng = np.random.default_rng(2)
+    plan_targets = [5, 40, 71]
+    plan = [_group_plan(rng, tg, ns) for tg, ns in zip(plan_targets, [4, 5, 6])]
+    path = tmp_path / "StudyQ" / "Q_01" / "SE001" / "Test" / "Grey-to-Color" / "Q_01_SE001_Grey-to-Color_Test01.edf"
+    _write_edf(path, plan)
+    epochs, text, info = parse_bigp3bci_edf(str(path))
+    assert info["group_flash"] and info["flashes_per_seq"] == 12
+    assert info["agreement"]["is_adaptive"] and info["agreement"]["n_characters_detected"] == 3
+    assert abs(info["soa_s"] - SOA / FS) < 1e-6
+    md = epochs.metadata
+    assert "lit_mask" in md.columns and sorted(md.char_index.unique()) == [0, 1, 2]
+    assert md.groupby("char_index").sequence_in_char.max().tolist() == [4, 5, 6]
+    # round-trip through .fif keeps the string column
+    out = tmp_path / "q-epo.fif"; epochs.save(str(out), overwrite=True)
+    n_seqs = [4, 5, 6]
+    for ci, tg in enumerate(plan_targets):
+        logp = np.zeros(N_CELLS)          # same accumulation the decoder performs
+        for seq in range(1, n_seqs[ci] + 1):
+            post = rp.real_eeg_classifier_stream(str(out), ci, seq, _Clf(), None, N_ROWS, N_COLS, 12)
+            assert post.shape == (N_CELLS,)
+            logp += np.log(np.clip(post, 1e-9, 1.0))
+        assert int(np.argmax(logp)) == tg, (ci, tg, int(np.argmax(logp)))
+
