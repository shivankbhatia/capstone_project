+FS, N_ROWS, N_COLS = 256, 9, 8
+N_CELLS = N_ROWS * N_COLS
+SOA, FLASH_LEN = 32, 16
+
+
+def _write_edf(path, flash_plan, n_eeg=16, seed=0):
+    """flash_plan: list of chars; each = list of sequences; each sequence = list of
+    (code, lit_cells, is_target). Returns (path, target flat indices 0-based)."""
+    rng = np.random.default_rng(seed)
+    n_flash = sum(len(s) for ch in flash_plan for s in ch)
+    n = 600 + n_flash * SOA + 9400   # long enough for the 0.1 Hz FIR highpass
+    eeg = rng.normal(0, 2e-6, (n_eeg, n))
+    cells = np.zeros((N_CELLS, n)); stype = np.zeros(n); sbegin = np.zeros(n)
+    scode = np.zeros(n); cur = np.zeros(n); sel = np.zeros(n)
+    t = 512; targets = []
+    for ch in flash_plan:
+        target = next(c for seq in ch for (_, lit, tg) in seq if tg for c in lit if all(
+            c in l2 for s2 in ch for (_, l2, t2) in s2 if t2))
+        targets.append(target)
+        start = t
+        for seq in ch:
+            for code, lit, is_t in seq:
+                sbegin[t:t + FLASH_LEN] = 1; scode[t:t + FLASH_LEN] = code
+                for c in lit:
+                    cells[c, t:t + FLASH_LEN] = 1
+                if is_t:
+                    stype[t:t + FLASH_LEN] = 1
+                    eeg[:, t + 60:t + 80] += 2e-5     # P300-like bump
+                t += SOA
+        cur[start:t] = target + 1
+        sel[t + 2:t + 10] = target + 1
+        t += SOA
+    labels = [f"L{i}" for i in range(N_CELLS)]
+    names = [f"EEG_{x}" for x in ["Fz", "Cz", "Pz", "Oz", "F3", "F4", "C3", "C4", "P3", "P4",
+                                 "T7", "T8", "CP3", "CP4", "PO7", "PO8"][:n_eeg]]
+    names += [f"{labels[i]}_{i // N_COLS + 1}_{i % N_COLS + 1}" for i in range(N_CELLS)]
+    names += ["StimulusType", "SelectedTarget", "SelectedRow", "SelectedColumn", "PhaseInSequence",
+              "StimulusBegin", "StimulusCode", "CurrentTarget", "FakeFeedback", "DisplayResults"]
+    zeros = np.zeros(n)
+    data = np.vstack([eeg, cells, stype, sel, zeros, zeros, zeros, sbegin, scode, cur, zeros, zeros])
+    info = mne.create_info(names, FS, ch_types=["eeg"] * n_eeg + ["misc"] * (len(names) - n_eeg))
+    raw = mne.io.RawArray(data, info, verbose=False)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    mne.export.export_raw(str(path), raw, fmt="edf", overwrite=True, verbose=False)
+    return targets
+
+
+def _group_plan(rng, target, n_seqs):
+    """12 flashes of 6 random cells per sequence; exactly one flash holds the target."""
+    chars = []
+    seqs = []
+    for _ in range(n_seqs):
+        perm = rng.permutation(N_CELLS)
+        groups = [perm[i * 6:(i + 1) * 6].tolist() for i in range(12)]
+        seqs.append([(0, g, target in g) for g in groups])
+    # running counter code, like Study Q
+    k = 0
+    for seq in seqs:
+        for j, (_, g, tg) in enumerate(seq):
+            k += 1; seq[j] = (k, g, tg)
+    return seqs
+
+
+def _rc_plan(target, n_seqs, rng):
+    r, c = divmod(target, N_COLS)
+    seqs = []
+    for _ in range(n_seqs):
+        order = rng.permutation(N_ROWS + N_COLS) + 1
+        seq = []
+        for code in order:
+            if code <= N_ROWS:
+                lit = [(code - 1) * N_COLS + cc for cc in range(N_COLS)]
+                seq.append((int(code), lit, (code - 1) == r))
+            else:
+                col = code - N_ROWS - 1
+                lit = [rr * N_COLS + col for rr in range(N_ROWS)]
+                seq.append((int(code), lit, col == c))
+        seqs.append(seq)
+    return seqs
+
+
+class _Clf:
+    """Stand-in classifier: target iff the P300 bump is present."""
+    def predict_proba(self, X):
+        feat = X[:, :, 90:102].mean(axis=(1, 2))
+        p = 1 / (1 + np.exp(-(feat - 1e-5) / 2e-6))
+        return np.stack([1 - p, p], axis=1)
+
+
+def test_membership_matches_row_column_exactly():
+    rng = np.random.default_rng(1)
+    codes, masks, probs = [], [], rng.uniform(0.02, 0.98, 17 * 3)
+    for _ in range(3):
+        for code in range(1, 18):
+            lit = np.zeros(N_CELLS, int)
+            if code <= N_ROWS:
+                lit[(code - 1) * N_COLS:code * N_COLS] = 1
+            else:
+                lit[(code - N_ROWS - 1)::N_COLS] = 1
+            codes.append(code); masks.append("".join(map(str, lit)))
+    a = rp.row_column_posterior(probs, codes, N_ROWS, N_COLS)
+    b = rp.membership_posterior(probs, masks)
+    assert np.allclose(a, b, atol=1e-12)
+
