<mxfile host="app.diagrams.net" modified="2026-10-26T10:30:47Z" agent="Codex" version="24.7.17" type="device"><diagram id="classifier-architecture" name="Classifier architecture"><mxGraphModel dx="1700" dy="1230" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1230" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="Study D — EEG classifier architecture" style="text;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="480" y="20" width="740" height="42" as="geometry" /></mxCell><mxCell id="lane-data" value="A. Fixed input and clean-pool boundary" style="swimlane;horizontal=1;startSize=30;collapsible=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="490" height="460" as="geometry" /></mxCell><mxCell id="lane-select" value="B. Training and candidate selection" style="swimlane;horizontal=1;startSize=30;collapsible=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="90" width="480" height="460" as="geometry" /></mxCell><mxCell id="lane-loso" value="C. Reviewer-facing LOSO evaluation" style="swimlane;horizontal=1;startSize=30;collapsible=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="90" width="600" height="460" as="geometry" /></mxCell><mxCell id="lane-runtime" value="D. Locked inference score interface" style="swimlane;horizontal=1;startSize=30;collapsible=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="590" width="1030" height="520" as="geometry" /></mxCell><mxCell id="lane-manifest" value="E. Separate manifest evaluation" style="swimlane;horizontal=1;startSize=30;collapsible=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="590" width="570" height="250" as="geometry" /></mxCell><mxCell id="cache" value="Clean Study D cache&lt;br/&gt;X: epochs × channels × samples&lt;br/&gt;y: 0 non-target / 1 target&lt;br/&gt;subject, run, char, sequence, stimulus code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="55" y="145" width="210" height="120" as="geometry" /></mxCell><mxCell id="locks" value="Fixed preprocessing + split locks&lt;br/&gt;1–12 Hz; baseline off&lt;br/&gt;all common channels&lt;br/&gt;held-out manifest excluded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="145" width="195" height="120" as="geometry" /></mxCell><mxCell id="guard" value="Training-pool guard&lt;br/&gt;83 RC/Train runs&lt;br/&gt;17 subjects; no held-out run IDs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="160" y="310" width="230" height="95" as="geometry" /></mxCell><mxCell id="cache-schema" value="Cache metadata&lt;br/&gt;seq_idx; stim_code; char_idx&lt;br/&gt;subject; run_id; condition&lt;br/&gt;manifest SHA and filter attrs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="155" y="435" width="240" height="90" as="geometry" /></mxCell><mxCell id="feature" value="Feature transform&lt;br/&gt;0–0.8 s; decimation 2&lt;br/&gt;flatten time × channel samples" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="585" y="145" width="200" height="90" as="geometry" /></mxCell><mxCell id="candidates" value="Candidate families&lt;br/&gt;M0 SGD; M1 SWLDA; M2 shrinkage LDA&lt;br/&gt;M3a/M3b xDAWN; stack; Riemann&lt;br/&gt;EEGNet NOT RUN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="805" y="145" width="200" height="115" as="geometry" /></mxCell><mxCell id="locked-m0" value="Paper-final Study D model: clean M0&lt;br/&gt;SGD log-loss; L2 α=.01; averaged&lt;br/&gt;class weights {0:1, 1:5}; five passes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="325" width="270" height="110" as="geometry" /></mxCell><mxCell id="temperature" value="Locked row/column sequence temperature&lt;br/&gt;T = 4.1869360663&lt;br/&gt;fit on clean-pool run-grouped OOF NLL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="465" width="330" height="65" as="geometry" /></mxCell><mxCell id="outer" value="Outer split&lt;br/&gt;Leave one of 17 subjects out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1090" y="145" width="200" height="75" as="geometry" /></mxCell><mxCell id="inner" value="Inner calibration scores&lt;br/&gt;run-grouped OOF&lt;br/&gt;training subjects only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1320" y="145" width="285" height="75" as="geometry" /></mxCell><mxCell id="fit-test" value="Per fold: fit M0 on other subjects&lt;br/&gt;score held-out subject&lt;br/&gt;fit fold temperature from inner OOF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1115" y="275" width="250" height="100" as="geometry" /></mxCell><mxCell id="loso-metrics" value="LOSO output&lt;br/&gt;84,660 epochs; 4,980 sequences&lt;br/&gt;498 chars; AUC .7869&lt;br/&gt;full/stopped acc. 74.70 / 73.90%&lt;br/&gt;calibrated row/col NLL 1.6639" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1390" y="275" width="235" height="145" as="geometry" /></mxCell><mxCell id="loso-note" value="Cache only: 83 clean runs&lt;br/&gt;manifest test runs not loaded&lt;br/&gt;per-fold temperatures: 4.301–4.940" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1190" y="455" width="350" height="65" as="geometry" /></mxCell><mxCell id="runtime-input" value="Incoming epoch tensor&lt;br/&gt;(n_epochs, n_channels, n_times)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="675" width="205" height="85" as="geometry" /></mxCell><mxCell id="scorer" value="EpochFeatureScorer&lt;br/&gt;locked channel order&lt;br/&gt;window 0–0.8 s; decim 2&lt;br/&gt;flatten + saved scaler" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="320" y="675" width="220" height="105" as="geometry" /></mxCell><mxCell id="logits" value="M0 decision_function&lt;br/&gt;one target-vs-nontarget logit&lt;br/&gt;per flash epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="600" y="675" width="190" height="85" as="geometry" /></mxCell><mxCell id="scale" value="calibrated_logits&lt;br/&gt;divide by stored T" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="675" width="160" height="85" as="geometry" /></mxCell><mxCell id="seq" value="aggregate_flash_logits&lt;br/&gt;sum by row / column code&lt;br/&gt;softmax row, softmax column" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="165" y="865" width="250" height="100" as="geometry" /></mxCell><mxCell id="grid" value="Grid evidence&lt;br/&gt;outer product row × column&lt;br/&gt;valid flash count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="480" y="865" width="220" height="90" as="geometry" /></mxCell><mxCell id="consumer" value="Downstream consumers&lt;br/&gt;LM/fusion prior; sequential decoder&lt;br/&gt;stop rule is downstream of classifier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1"><mxGeometry x="760" y="865" width="240" height="100" as="geometry" /></mxCell><mxCell id="manifest" value="Frozen Study D manifest&lt;br/&gt;57 runs: 19 RC/Train,&lt;br/&gt;20 Dyn, 18 DynBigram" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1125" y="665" width="220" height="95" as="geometry" /></mxCell><mxCell id="one-shot" value="One-shot M0 vs M3a replay&lt;br/&gt;separate held-out population&lt;br/&gt;not LOSO validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1380" y="665" width="230" height="95" as="geometry" /></mxCell><mxCell id="manifest-result" value="Manifest score: M0 fused 78.40%; M3a 74.26%&lt;br/&gt;LOSO answers subject generalization on clean RC/Train" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1160" y="785" width="445" height="50" as="geometry" /></mxCell><mxCell id="e1" value="cache + metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="cache" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="split / preprocessing" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="locks" target="guard"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="validated training pool" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=12;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="guard" target="cache-schema"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="clean training epochs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=12;" edge="1" parent="1" source="guard" target="feature"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="feature" target="candidates"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="final selection" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=12;" edge="1" parent="1" source="candidates" target="locked-m0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="locked calibration" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=12;" edge="1" parent="1" source="locked-m0" target="temperature"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="same clean cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="guard" target="outer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="subject held out" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="outer" target="fit-test"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="fold-specific T" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;fontSize=12;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="inner" target="fit-test"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="pooled cross-fitted scores" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontSize=12;" edge="1" parent="1" source="fit-test" target="loso-metrics"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="export estimator / scaler" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=12;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="locked-m0" target="scorer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="runtime-input" target="scorer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="scorer" target="logits"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="logits" target="scale"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="scale" target="seq"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="seq" target="grid"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="grid" target="consumer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="locked baseline" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=12;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="locked-m0" target="one-shot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="manifest" target="one-shot"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="one-shot" target="manifest-result"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="classifier-mermaid-source" name="Mermaid source"><mxGraphModel dx="1500" dy="1050" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="mermaid-source" value="Mermaid source for the architecture page&lt;br&gt;&lt;br&gt;&lt;pre&gt;flowchart TB&#10;  subgraph INPUTS[Fixed inputs]&#10;    CACHE[Clean Study D cache&amp;lt;br/&amp;gt;X epochs × channels × samples; y target label&amp;lt;br/&amp;gt;run, subject, character, sequence, stimulus code]&#10;    LOCK[Locks and preprocessing config&amp;lt;br/&amp;gt;1–12 Hz; baseline off; all common channels]&#10;    GUARD[Protocol guard&amp;lt;br/&amp;gt;83 RC/Train runs; reject held-out manifest IDs]&#10;    CACHE --&amp;gt; GUARD&#10;    LOCK --&amp;gt; GUARD&#10;  end&#10;  subgraph TRAINING[Training and model selection]&#10;    FEAT[Feature transform&amp;lt;br/&amp;gt;0–0.8 s; decimation 2; flatten]&#10;    CAND[Candidate comparisons&amp;lt;br/&amp;gt;M0 SGD; M1 SWLDA; M2 shrinkage LDA;&amp;lt;br/&amp;gt;M3a/M3b xDAWN; stack; Riemann]&#10;    CHOICE[Locked final model&amp;lt;br/&amp;gt;M0 clean streaming SGD&amp;lt;br/&amp;gt;log-loss; L2 alpha .01; class weights 1:5]&#10;    GUARD --&amp;gt; FEAT --&amp;gt; CAND --&amp;gt; CHOICE&#10;  end&#10;  subgraph LOSO[Reviewer-facing LOSO evaluation]&#10;    OUTER[17 outer folds&amp;lt;br/&amp;gt;Leave one subject out]&#10;    INNER[Within remaining 16 subjects:&amp;lt;br/&amp;gt;run-grouped inner OOF scores]&#10;    TEMP[Fit fold temperature&amp;lt;br/&amp;gt;minimize row/column sequence NLL]&#10;    FIT[Fit M0 on outer-training subjects]&#10;    TEST[Score held-out subject epochs]&#10;    CAL[Scale logits by that fold temperature]&#10;    OUTER --&amp;gt; INNER --&amp;gt; TEMP&#10;    OUTER --&amp;gt; FIT --&amp;gt; TEST --&amp;gt; CAL&#10;    TEMP --&amp;gt; CAL&#10;    CAL --&amp;gt; AGG[Aggregate 17-flash sequences&amp;lt;br/&amp;gt;sum by row/column; softmax; grid posterior]&#10;    AGG --&amp;gt; METRIC[Pool cross-fitted LOSO scores&amp;lt;br/&amp;gt;AUC; sequence NLL; full/stopped character accuracy]&#10;  end&#10;  GUARD --&amp;gt; OUTER&#10;  CHOICE -. same locked recipe .-&amp;gt; FIT&#10;  subgraph DEPLOY[Locked inference interface]&#10;    EPOCH[Incoming epoch tensor&amp;lt;br/&amp;gt;epoch × locked channels × samples]&#10;    TRANS[EpochFeatureScorer&amp;lt;br/&amp;gt;window 0–0.8 s; decim 2; flatten; scaler]&#10;    LOGIT[M0 decision score&amp;lt;br/&amp;gt;per-flash target logit]&#10;    SCALE[Locked sequence calibration&amp;lt;br/&amp;gt;T = 4.1869360663]&#10;    SEQ[Row/column evidence&amp;lt;br/&amp;gt;summed logits; separate softmax vectors]&#10;    GRID[Grid posterior&amp;lt;br/&amp;gt;outer product of row × column]&#10;    DOWNSTREAM[Consumers&amp;lt;br/&amp;gt;LM/fusion prior and sequential decoder]&#10;    EPOCH --&amp;gt; TRANS --&amp;gt; LOGIT --&amp;gt; SCALE --&amp;gt; SEQ --&amp;gt; GRID --&amp;gt; DOWNSTREAM&#10;  end&#10;  CHOICE -. exported scorer .-&amp;gt; TRANS&#10;  subgraph HELDOUT[Separate one-shot manifest evaluation]&#10;    MANIFEST[57-run frozen manifest&amp;lt;br/&amp;gt;RC/Train + Dyn + DynBigram]&#10;    REPLAY[One-shot evaluator&amp;lt;br/&amp;gt;M0 baseline vs M3a candidate]&#10;    RESULT[Manifest results&amp;lt;br/&amp;gt;separate condition-shift population; not LOSO]&#10;    MANIFEST --&amp;gt; REPLAY --&amp;gt; RESULT&#10;  end&#10;  CHOICE -. baseline .-&amp;gt; REPLAY&lt;/pre&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Courier New;fontSize=14;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="30" width="1440" height="970" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>