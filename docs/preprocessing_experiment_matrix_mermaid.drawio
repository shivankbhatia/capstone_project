  <diagram id="matrix" name="Experiment matrix">
    <mxGraphModel dx="1400" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="Preprocessing experiment matrix" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Study D clean-pool probes: M1 SWLDA · 83 runs · 498 characters · paired run bootstrap, 10,000 resamples" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="35" y="65" width="1250" height="30" as="geometry"/></mxCell>

        <mxCell id="p7" value="P7 · Filter on vs off&#xa;0.1–30 Hz vs no filter; baseline on&#xa;Δ AUC +0.24 pp [−0.40, +0.93]&#xa;Δ accuracy −3.01 pp [−7.23, +1.20]&#xa;Intervals span zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="130" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="p8" value="P8 · Baseline on vs off&#xa;0.1–30 Hz in both arms&#xa;Δ AUC +0.30 pp [−0.35, +0.98]&#xa;Δ accuracy −2.01 pp [−6.63, +2.81]&#xa;Intervals span zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1"><mxGeometry x="475" y="130" width="410" height="145" as="geometry"/></mxCell>
        <mxCell id="p9" value="P9 · Filter comparison&#xa;1–12 vs 0.1–30 Hz; baseline off&#xa;Δ AUC +2.49 pp [+1.94, +3.06]&#xa;Δ accuracy +5.02 pp [+0.80, +9.24]&#xa;M1 evidence; indirect for paper-final M0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1"><mxGeometry x="915" y="130" width="445" height="145" as="geometry"/></mxCell>

        <mxCell id="phase2" value="Phase-2 screen · M2 shrinkage LDA&#xa;Bandpass arms: 0.1–20, 0.5–15, 1–12 Hz&#xa;Also screened: window, decimation, channels, artifact rejection, baseline&#xa;Lock: 1–12 Hz · 0–0.8 s · decim 2 · all channels · baseline off&#xa;0–0.6 s had higher epoch AUC but lower character accuracy; not selected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="325" width="650" height="180" as="geometry"/></mxCell>
        <mxCell id="fixes" value="Parser / integrity work&#xa;Fixed RC text: CurrentTarget blocks&#xa;Adaptive text: SelectedTarget pulses preserve repeats&#xa;Grid compare: 205/205 false type mismatches&#xa;Final Study D reprocess pass: 307/307 outputs; all grids 9×8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="715" y="325" width="645" height="180" as="geometry"/></mxCell>

        <mxCell id="dead" value="Stopped / superseded arms&#xa;RP/CWT + CNN: 22.06%; headline comparison superseded&#xa;RP/CWT + LDA: majority-class collapse&#xa;Normalization ablation: not run&#xa;Logistic regression: not attempted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#555555;dashed=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35" y="555" width="650" height="155" as="geometry"/></mxCell>
        <mxCell id="final" value="Final recorded Study D choice&#xa;Paper headline Rungs 0–4: clean M0&#xa;Effective bandpass: 1–12 Hz · baseline off&#xa;P7/P8: no detectable run-level difference; P9 favors 1–12 Hz on M1 only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="715" y="555" width="645" height="155" as="geometry"/></mxCell>

        <mxCell id="e1" value="screened" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#6c8ebf;fontSize=12;" edge="1" parent="1" source="phase2" target="final"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="retained fixes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#9673a6;fontSize=12;" edge="1" parent="1" source="fixes" target="final"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="note" value="P7–P9 are run-grouped out-of-fold M1 probes, not evidence from paper-final M0. Intervals are descriptive; no model-selection correction." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="35" y="760" width="1280" height="35" as="geometry"/></mxCell>
      </root>
