        <mxCell id="source-hint" value="Copy the source, then choose Arrange → Insert → Mermaid." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="30" y="65" width="1000" height="30" as="geometry"/></mxCell>
        <mxCell id="source" value="flowchart TD&#xa;    A[Preprocessing experiments]&#xa;    A --&gt; P[Matched M1 clean-pool probes]&#xa;    P --&gt; P7[P7: filter on vs off; baseline on]&#xa;    P --&gt; P8[P8: baseline on vs off; 0.1–30 Hz]&#xa;    P --&gt; P9[P9: 1–12 vs 0.1–30 Hz; baseline off]&#xa;    P7 --&gt; N[CI spans zero: no detectable run-level difference]&#xa;    P8 --&gt; N&#xa;    P9 --&gt; Y[CI above zero: favors 1–12 Hz on M1 split]&#xa;    A --&gt; S[Phase-2 M2 screen: bandpass, window, decimation, channels, artifacts, baseline]&#xa;    S --&gt; L[Locked setting: 1–12 Hz; baseline off; 0–0.8 s; decim 2; all channels]&#xa;    A --&gt; F[Parser fixes: CurrentTarget blocks; SelectedTarget pulses; grid type fix]&#xa;    A --&gt; D[Dead arms: RP/CWT CNN; RP/CWT LDA; normalization ablation not run]&#xa;    Y --&gt; M[Paper headline: clean M0; Rungs 0–4; 1–12 Hz]&#xa;    L --&gt; M&#xa;    F --&gt; M&#xa;    classDef probe fill:#fff2cc,stroke:#d6b656,color:#222;&#xa;    classDef keep fill:#d5e8d4,stroke:#82b366,color:#222;&#xa;    classDef dead fill:#f5f5f5,stroke:#999,color:#555;&#xa;    class P7,P8,P9,N,Y probe;&#xa;    class L,F,M keep;&#xa;    class D dead;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=16;fontFamily=Courier New;fontSize=14;fillColor=#f8f9fa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="30" y="110" width="1320" height="720" as="geometry"/></mxCell>
